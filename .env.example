# Relay (in-app assistant)
# Server-side key for the assistant. Never expose this to the browser.
RELAY_API_KEY=
# Set to "false" to hide Relay everywhere (button, shortcut, palette, route).
NEXT_PUBLIC_RELAY_ENABLED=true

# Relay rate limiting (server-side burst + daily cap)
#
# Option A — local dev with Docker/Homebrew Redis (recommended when testing limits):
#   REDIS_URL=redis://127.0.0.1:6379
#   Leave Upstash vars unset.
#
# Option B — no Redis (single-process in-memory limits; fine for solo local dev):
#   Unset REDIS_URL, UPSTASH_REDIS_REST_URL, and UPSTASH_REDIS_REST_TOKEN.
#
# Option C — production / shared limits via Upstash REST:
#   UPSTASH_REDIS_REST_URL=https://….upstash.io
#   UPSTASH_REDIS_REST_TOKEN=
#   Unset REDIS_URL (local TCP takes priority when both are set).
#
# REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Relay speech-to-text (optional). Enables the "Grok" dictation engine in Settings -> Relay.
# Server-only; audio is forwarded to xAI for transcription.
# XAI_API_KEY=

# Analytics (privacy-first, ships dark)
# Kill switch. Default off; set to "true" in Production only. Inlined at build time,
# so changing it needs a redeploy. Dev, test and webdriver sessions stay off regardless.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# PostHog project key. Public by design, but only ever read server-side by /api/ingest.
# POSTHOG_KEY=
# PostHog ingest host. US is the launch value; use https://eu.i.posthog.com for EU.
# POSTHOG_HOST=https://us.i.posthog.com
# Id of the in-app feedback survey (see POSTHOG_SETUP.md). Feedback is dropped when unset.
# POSTHOG_FEEDBACK_SURVEY_ID=
